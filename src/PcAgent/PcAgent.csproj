<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(NetVersion)-windows</TargetFramework>
    <RootNamespace>PcAgent</RootNamespace>
    <AssemblyName>PcAgent</AssemblyName>
    <Version>0.3.0</Version>
    <Product>PC Health Agent</Product>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- 경량화: 에이전트 자체가 PC에 부담을 주지 않도록 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- 배포 기본값: Native AOT 단일 exe (.NET 런타임 설치 불필요, 메모리 최소) -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
  </ItemGroup>

  <!-- 정적 import DLL(version, bcrypt, crypt32 등)도 exe 폴더가 아닌 System32 에서만 찾도록 (LOAD_LIBRARY_SEARCH_SYSTEM32) -->
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <LinkerArg Include="/DEPENDENTLOADFLAG:0x800" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PcAgent.Tests" />
  </ItemGroup>

</Project>
